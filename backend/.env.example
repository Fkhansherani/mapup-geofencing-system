# Copy these into your shell or hosting dashboard. All have defaults for local development.
PORT=8080
DATABASE_URL=postgres://geo:geo@localhost:5433/geofence?sslmode=disable
# "*" or a comma separated list, e.g. https://my-app.vercel.app
ALLOWED_ORIGINS=*
# Max POST /vehicles/location requests per minute per IP (0 = no limit)
LOCATION_RATE_LIMIT_PER_MIN=120
